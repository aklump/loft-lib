{
  "name": "aklump/loft-lib",
  "description": "Core utilities provided by In the Loft Studios",
  "type": "library",
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Aaron Klump",
      "email": "sourcecode@intheloftstudios.com"
    }
  ],
  "autoload": {
    "psr-4": {
